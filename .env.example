# --- Provider keys (only the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Models ---
RAG_LLM_PROVIDER=openai            # openai | anthropic
RAG_LLM_MODEL=gpt-4.1-mini
RAG_EMBEDDING_PROVIDER=openai      # openai | hashing (offline, for local dev/tests)
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=1536

# --- Storage ---
RAG_VECTOR_STORE=pgvector          # pgvector | memory
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- Retrieval ---
RAG_RETRIEVAL_MODE=hybrid          # vector | keyword | hybrid
RAG_RERANKER=llm                   # llm | none
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# --- Cost tracking (USD per 1M tokens, optional) ---
RAG_PRICE_INPUT_PER_MTOK=
RAG_PRICE_OUTPUT_PER_MTOK=

RAG_LOG_LEVEL=INFO
